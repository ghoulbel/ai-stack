# Copy to .env, or run ../identity-stack/bootstrap.sh which generates and syncs it.
# NEVER commit .env.

# OAuth client secret for OpenWebUI.
#
# Generated by ../identity-stack/bootstrap.sh and mirrored here from
# identity-stack/.env, because Docker Compose cannot read a .env from a sibling
# directory — one value has to exist in two files. The blueprint
# blueprints/apps/openwebui.yaml injects it with Authentik's !Env tag, so the
# credential itself is never written into a tracked file.
#
# It is copied, not shared: editing this file does nothing until you re-run the
# bootstrap script, and rotating it requires re-applying the blueprint AND
# recreating the open-webui container. Treat it as permanent.
OPENWEBUI_OAUTH_SECRET=
# Tailscale IPv4. Written by ../bootstrap.sh; used to publish admin and
# machine-to-machine ports on the tailnet without exposing them to the LAN.
TAILSCALE_IP=100.102.27.93
TAILSCALE_DNS=rog-strix.zapus-pence.ts.net
